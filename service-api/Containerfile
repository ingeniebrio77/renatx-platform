# =============================================================================
# Containerfile — service-api (Python 3.12 + FastAPI + uv)
# Compatible con Podman rootless y Docker
# Non-root user para seguridad
# =============================================================================
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /app

# Variables para optimizar uv y Python dentro del contenedor
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1

# Usuario no-root para seguridad
RUN useradd -m -u 1001 appuser && chown -R appuser:appuser /app
USER appuser

# Copiamos primero pyproject.toml para aprovechar la caché de capas
COPY --chown=appuser:appuser pyproject.toml ./

# Instalamos las dependencias en el entorno virtual del proyecto
RUN uv sync --no-install-project --no-dev

# Copiamos el código fuente de la aplicación
COPY --chown=appuser:appuser app ./app

EXPOSE 8000

# Ejecutamos Uvicorn como usuario no-root
CMD ["uv", "run", "--no-project", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]