{
  "$schema": "https://opencode.ai/config.json",
  // Configuración OpenCode V2 para el proyecto Renatx Platform (renatx.com)
  // Documentación oficial: https://opencode.ai/v2/docs/mcp-servers/
  "mcp": {
    "servers": {
      // 1. Context7: Documentación oficial actualizada en tiempo real
      // (FastAPI, Next.js App Router, Traefik v3, Terraform, Ansible, Stripe)
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false
      },
      // 2. Cloudflare Docs MCP: Consultas oficiales sobre Cloudflare Registrar, DNS y Zero Trust
      "cloudflare-docs": {
        "type": "remote",
        "url": "https://docs.mcp.cloudflare.com/mcp",
        "oauth": false
      },
      // 3. Stripe MCP (Preconfigurado y desactivado hasta que uses tu cuenta Stripe real).
      // Para activarlo en el futuro: cambia "disabled": false y ejecuta `/mcps` en OpenCode.
      "stripe": {
        "type": "remote",
        "url": "https://mcp.stripe.com",
        "disabled": true
      },
      // 4. GitHub MCP — vía PROXY LOCAL (systemd --user: renatx-gh-mcp-proxy.service).
      //    El MCP remoto de GitHub NO acepta el flujo OAuth de OpenCode (sin Dynamic
      //    Client Registration) y la sustitución {env:} no se aplica en headers de
      //    servidores remotos. Solución: proxy HTTP local en 127.0.0.1:49231 que
      //    reenvía contra https://api.githubcopilot.com/mcp/ inyectando el PAT leído
      //    del entorno del usuario (systemd --user set-environment). El token jamás
      //    vive en este fichero ni en el repositorio.
      "github": {
        "type": "remote",
        "url": "http://127.0.0.1:49231/mcp",
        "oauth": false
      },
      // 5. Playwright MCP (Servidor local oficial de Microsoft):
      //    Automatización de navegador para pruebas E2E de la web comercial
      //    (probar el botón de Stripe, el selector ES/DE y el panel RustDesk)
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"]
      },
      // 6. TestSprite MCP (Servidor local de agentes de testing):
      //    La API key NUNCA va en el repo: el wrapper la lee del entorno del
      //    usuario (fish universal TESTSPRITE_API_KEY, decodificando escapes
      //    \\xHH de fish_variables) y la exporta al proceso MCP hijo.
      //    Requisito: set -Ux TESTSPRITE_API_KEY sk-member-... en fish.
      "testsprite": {
        "type": "local",
        "command": ["/home/renato/.local/share/renatx/bin/testsprite-mcp-wrapper.sh"],
        "cwd": "/home/renato/Projectos/Pagina"
      },
      // 7. Trivy MCP (plugin oficial de Aqua Security — `trivy plugin install mcp`):
      //    Escaneo de vulnerabilidades en imágenes Podman, filesystem, repos,
      //    misconfiguraciones y secretos. Experimental (stdio).
      "trivy": {
        "type": "local",
        "command": ["trivy", "mcp"]
      },
      // 9. OWASP ZAP MCP (DAST dinámico contra renatx.localhost):
      //    Add-on oficial "MCP Integration" v0.4.0. Daemon headless persistente:
      //    systemctl --user status renatx-zap-daemon.service
      //    API REST en 127.0.0.1:8090, MCP en 127.0.0.1:8282 (solo localhost).
      "zap": {
        "type": "remote",
        "url": "http://127.0.0.1:8282/",
        "oauth": false
      },
      // 8. PostgreSQL MCP ("postgres-mcp" de Crystal DBA, vía Podman para respetar db_net interna):
      //    Conecta a renatx_db de forma efímera (requiere `make up` levantado).
      //    Modo RESTRICTED (solo lectura + EXPLAIN) como capa de seguridad.
      "postgres": {
        "type": "local",
        "command": ["make", "mcp-postgres"],
        "timeout": {"startup": 45000, "catalog": 30000, "execution": 300000},
        "cwd": "/home/renato/Projectos/Pagina"
      }
    }
  }
}
