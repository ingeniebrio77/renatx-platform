{
  "$schema": "https://opencode.ai/config.json",
  // Configuración OpenCode V2 para el proyecto Renatx Platform (renatx.com)
  // Documentación oficial: https://opencode.ai/v2/docs/mcp-servers/
  "mcp": {
    "servers": {
      // 1. Context7: Documentación oficial actualizada en tiempo real
      // (FastAPI, Next.js App Router, Traefik v3, Terraform, Ansible, Stripe)
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false
      },
      // 2. Cloudflare Docs MCP: Consultas oficiales sobre Cloudflare Registrar, DNS y Zero Trust
      "cloudflare-docs": {
        "type": "remote",
        "url": "https://docs.mcp.cloudflare.com/mcp",
        "oauth": false
      },
      // 3. Stripe MCP (Preconfigurado y desactivado hasta que uses tu cuenta Stripe real).
      // Para activarlo en el futuro: cambia "disabled": false y ejecuta `/mcps` en OpenCode.
      "stripe": {
        "type": "remote",
        "url": "https://mcp.stripe.com",
        "disabled": true
      },
      // 4. GitHub MCP (Servidor remoto oficial de GitHub, OAuth con tu cuenta,
      //    ideal para gestionar issues/PRs/repo renatx-platform sin exponer tokens)
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/"
      },
      // 5. Playwright MCP (Servidor local oficial de Microsoft):
      //    Automatización de navegador para pruebas E2E de la web comercial
      //    (probar el botón de Stripe, el selector ES/DE y el panel RustDesk)
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"]
      },
      // 6. TestSprite MCP (Servidor local de agentes de testing):
      //    Desactivado por defecto hasta que generes tu API_KEY (sk-user-...)
      //    en https://www.testsprite.com/dashboard
      "testsprite": {
        "type": "local",
        "command": ["npx", "-y", "@testsprite/testsprite-mcp@latest"],
        "environment": {
          "API_KEY": "{env:TESTSPRITE_API_KEY}"
        },
        "disabled": true
      },
      // 7. Semgrep MCP (Remoto oficial — Requiere autenticación OAuth gratuita):
      //    SAST/SCA/secrets para service-api (Python) y service-web (TS/JS).
      //    Activar con: escribir /mcps en OpenCode y hacer login, o:
      //    opencode mcp auth semgrep
      "semgrep": {
        "type": "remote",
        "url": "https://mcp.semgrep.ai/mcp"
      },
      // 8. PostgreSQL MCP ("postgres-mcp" de Crystal DBA, vía Podman para respetar db_net interna):
      //    Conecta a renatx_db de forma efímera (requiere `make up` levantado).
      //    Modo RESTRICTED (solo lectura + EXPLAIN) como capa de seguridad.
      "postgres": {
        "type": "local",
        "command": ["make", "mcp-postgres"],
        "timeout": {"startup": 45000, "catalog": 30000, "execution": 300000},
        "cwd": "/home/renato/Projectos/Pagina"
      }
    }
  }
}
