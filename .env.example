# =============================================================================
# Variables de Entorno — Plataforma Renatx (renatx.com)
# Autor: Franco Renato Palavecino (Hamburgo, Alemania)
# =============================================================================

# --- Entorno y Dominio Base ---
# Valores posibles para ENV: local | preprod | prod
ENV=local

# En local usamos renatx.localhost (resuelve a 127.0.0.1 automáticamente).
# En preproducción: preprod.renatx.com
# En producción: renatx.com
BASE_DOMAIN=renatx.localhost

# Puerto HTTP expuesto en el host (8080 en local rootless sin sysctl; 80 en VPS)
HTTP_PORT=8080

# --- Base de Datos PostgreSQL (Aislada en red interna db_net) ---
POSTGRES_USER=renatx_admin
POSTGRES_PASSWORD=renatx_local_dev_password_change_me
POSTGRES_DB=renatx_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Seguridad y Autenticación JWT (service-api) ---
JWT_SECRET_KEY=super_secret_dev_key_renatx_2026_change_in_prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Monetización Stripe (Mock / Pruebas sin cargos reales) ---
STRIPE_SECRET_KEY=sk_test_mock_renatx_000000000000
STRIPE_WEBHOOK_SECRET=whsec_mock_renatx_000000000000
STRIPE_PRICE_ID_PRO=price_mock_renatx_pro_monthly
