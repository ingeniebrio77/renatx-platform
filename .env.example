# =============================================================================
# Variables de Entorno — Plataforma Renatx (renatx.com)
# Autor: Franco Renato Palavecino (Hamburgo, Alemania)
# =============================================================================
#
# Para generar ADMIN_PASSWORD_HASH:
#   En el contenedor o local: make password-hash
#   O manualmente: python -c "from app.core.passwords import hash_password; print(hash_password('tu-pass'))"
# =============================================================================

# --- Entorno y Dominio Base ---
# Valores posibles para ENV: local | preprod | prod
ENV=local

# En local usamos renatx.localhost (resuelve a 127.0.0.1 automáticamente).
# En preproducción: preprod.renatx.com
# En producción: renatx.com
BASE_DOMAIN=renatx.localhost

# Puerto HTTP expuesto en el host (8080 en local rootless sin sysctl; 80 en VPS)
HTTP_PORT=8080

# --- Base de Datos PostgreSQL (Aislada en red interna db_net) ---
POSTGRES_USER=renatx_admin
POSTGRES_PASSWORD=renatx_local_dev_password_change_me
POSTGRES_DB=renatx_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Seguridad y Autenticación JWT (service-api) ---
# REQUERIDO: Cambia JWT_SECRET_KEY en producción (>= 32 caracteres)
JWT_SECRET_KEY=super_secret_dev_key_renatx_2026_change_in_prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Credenciales del Panel de Instructor ---
# Usuario único con permisos de administrador
ADMIN_USERNAME=renato@renatx.com
# Hash PBKDF2 de la contraseña - GENERA CON: make password-hash
ADMIN_PASSWORD_HASH=pbkdf2_sha256$260000$...

# --- Limitación de Rate Login ---
# Máximos intentos fallidos por IP antes de bloqueo
LOGIN_RATE_LIMIT_ATTEMPTS=5
# Ventana de tiempo en segundos
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- CORS: Orígenes permitidos (separados por coma) ---
# En producción, el proxy (Traefik) sirve API y web bajo el mismo origen.
CORS_ORIGINS=http://renatx.localhost:8080,http://localhost:3000

# --- Documentación Interactiva: Habilitada por defecto fuera de prod ---
# ENABLE_DOCS=true  # Forzar en producción, no establecer para deshabilitar
# ENABLE_DOCS=false # Forzar en local, para probar control de docs

# --- Monetización Stripe (Mock / Pruebas sin cargos reales) ---
STRIPE_SECRET_KEY=sk_test_mock_renatx_000000000000
STRIPE_WEBHOOK_SECRET=whsec_mock_renatx_000000000000
STRIPE_PRICE_ID_PRO=price_mock_renatx_pro_monthly