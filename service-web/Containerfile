# =============================================================================
# Containerfile Multi-Stage — service-web (Next.js Standalone)
# Construye una imagen ligera y segura para Podman / Docker
# Node 24 Alpine (LTS) + non-root user
# =============================================================================

# Etapa 1: Instalación de dependencias
FROM docker.io/library/node:24-alpine AS deps
WORKDIR /app
RUN corepack enable && corepack prepare npm@10.0.0 --activate

COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund

# Etapa 2: Compilación del proyecto Next.js
FROM docker.io/library/node:24-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=development

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

# Etapa 3: Imagen final de ejecución (mínima)
FROM docker.io/library/node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME="0.0.0.0"

# Usuario no-root para seguridad
RUN addgroup -g 1001 appgroup && \
    adduser -D -u 1001 -G appgroup appuser

# Copiar artefactos de compilación
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

# Propiedad del usuario no-root
RUN chown -R appuser:appgroup /app

USER appuser

EXPOSE 3000

CMD ["node", "server.js"]