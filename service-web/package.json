    "@types/jest": "^29.5.12",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "5.5.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
